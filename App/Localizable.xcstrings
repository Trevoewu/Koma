    "Add a repository address to see its sources.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリのアドレスを追加すると、ソースが表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加仓库地址，即可看到其中的源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入來源庫網址，即可看到其中的來源。"
          }
        }
      }
    },
    "Add a source repository to browse manga from the web.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースリポジトリを追加すると、Web上のマンガを閲覧できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加源仓库，即可浏览网络上的漫画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入來源庫，即可瀏覽網路上的漫畫。"
          }
        }
      }
    },
